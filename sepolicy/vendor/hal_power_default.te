binder_call(hal_power_default, hal_oplus_touch_aidl)

r_dir_file(hal_power_default, vendor_sysfs_gpu)

hal_client_domain(hal_power_default, vendor_hal_oplus_touch)

allow hal_power_default hal_oplus_touch_aidl_service:service_manager find;
allow hal_power_default vendor_sysfs_gpu:file rw_file_perms;

# Display
allow hal_power_default vendor_proc_display:dir search;
allow hal_power_default vendor_proc_display:file w_file_perms;

# Oplus-Frame-Boost
type proc_frame_boost, fs_type, proc_type;
allow hal_power_default proc_frame_boost:file { read write open getattr };